{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/plan-measure-session.sh",
        "timeout": 30
      }
    ],
    "postToolUse": [
      {
        "command": ".cursor/hooks/plan-measure-inject.sh",
        "timeout": 30
      }
    ],
    "afterAgentResponse": [
      {
        "command": ".cursor/hooks/plan-execute-after-response.sh",
        "timeout": 60
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/plan-execute-stop.sh",
        "timeout": 240,
        "loop_limit": 40
      }
    ]
  }
}
