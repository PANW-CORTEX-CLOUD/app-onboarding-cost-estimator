{
  "schemaVersion": 1,
  "description": "Atomic per-meter validation ledger. One row per meterId: what the estimator CLAIMS vs what the official source SAYS. Re-crawled by scripts/validate-prices.mjs when verifiedAt is older than maxAgeDays[method]. Never edit verdict/observed by hand without re-running the crawler. A row that cannot be checked at all records lastAttemptedAt + blockedReason: the age clock resets so CI is not permanently red, but the verdict stays untrusted so the number is never presented as a vendor price.",
  "maxAgeDays": {
    "azure-retail-api": 30,
    "aws-price-list-api": 30,
    "official-doc": 90
  },
  "verdicts": {
    "verified": "Observed official price equals the claimed price within tolerance, and the units line up.",
    "mismatch": "Official source has a different price or a different unit denominator than claimed. Estimate is wrong until fixed.",
    "unsupported-meter": "The official price list has no such meter. The number is a proxy invented by this repo \u2014 it must not be presented as a vendor price.",
    "proxy": "Number is officially correct but is sourced from a different service's price list than the meterId/sourceUrl claims.",
    "unverified": "Not yet checked against an official source."
  },
